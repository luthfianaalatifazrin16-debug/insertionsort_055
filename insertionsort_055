#include <iostream>

using namespace std;

// Deklarasi variabel global
int arr[20];
int n;

// Prosedur untuk menginput data ke dalam array
void input()
{
    while (true)
    {
        cout << "Masukan Jumlah Data Pada Array : ";
        cin >> n;

        if (n <= 20)
        {
            break;
        }
        else
        {
            cout << "\nArray Tidak Boleh Lebih dari 20\n"
                 << endl;
        }
    }

    cout << endl;
    cout << "===============================" << endl;
    cout << "===== Masukkan Elemen Array =====" << endl;
    cout << "===============================" << endl;

    for (int i = 0; i < n; i++)
    {
        cout << "Data ke-" << (i + 1) << " : ";
        cin >> arr[i];
    }
}
